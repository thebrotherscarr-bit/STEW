# Invalid: nine-lines

A profile's instructions are at most 8 lines.

```json
{
  "stew": "2026-11-08-draft",
  "kind": "profile",
  "name": "eval-runner",
  "version": 1,
  "for": {
    "task": "run an eval set from the phone and report it",
    "capabilities": [
      "N8"
    ]
  },
  "tools": [
    "secondbrain_eval_start",
    "secondbrain_eval_status"
  ],
  "instructions": "Line 1.\nLine 2.\nLine 3.\nLine 4.\nLine 5.\nLine 6.\nLine 7.\nLine 8.\nLine 9.",
  "budgets": {
    "reads": 0,
    "tool_calls": 4
  },
  "reasoning": "low",
  "gates": {
    "bounds": [
      "keys",
      "archive",
      "untrusted-shell",
      "sitting"
    ],
    "extra": [
      "no set other than the one named"
    ]
  },
  "card": "plan",
  "success": {
    "check": "tool_call_args_match"
  },
  "summary": "<set> <tag>: <passed>/<total>, failed: <case ids>"
}
```
